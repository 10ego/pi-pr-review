      "expectedFindings": [
        {
          "id": "prior.tenant-check",
          "targetSeverity": "P1",
          "allowedSeverities": [
            "P0",
            "P1"
          ],
          "acceptableLocations": [
            {
              "path": "src/access.ts",
              "side": "RIGHT",
              "start": 2,
              "end": 2
            }
          ],
          "rationale": "Returning true for every tenant removes the ownership boundary and enables unauthorized cross-tenant document reads.",
