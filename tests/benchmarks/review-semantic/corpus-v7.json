            "correctness-contracts"
          ],
          "blocking": true,
          "crossFile": false,
          "requiredConcepts": [
            [
              "tenant",
              "ownership"
            ],
            [
              "true",
              "check"
            ],
            [
              "access",
              "read"
            ]
          ],
          "assertionPatterns": [
            [
              "(tenant|ownership).{0,100}(check|comparison|boundary)",
              "(check|comparison|boundary).{0,100}(tenant|ownership)"
            ]
          ],
          "contradictionPatterns": [
            "ownership (?:is|remains) enforced",
            "cross-tenant access (?:is|was) prevented"
          ]
        }
      ],
      "priorState": {
        "relationship": "incremental",
