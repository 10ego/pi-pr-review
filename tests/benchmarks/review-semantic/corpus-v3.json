      "id": "compile-export-removal",
      "title": "Removed exported request contract",
      "diff": "diffs/compile-export-removal.diff",
      "diffSha256": "be33415720d5789d0d74658a4e172c8243e37603e47830444f25289ed1e17eb7",
      "diffBytes": 703,
      "changedFiles": [
        "src/types.ts",
        "src/client.ts"
      ],
      "cleanControl": false,
      "crossFile": true,
      "expectedFindings": [
        {
          "id": "compile.missing-request-options",
          "targetSeverity": "P0",
          "allowedSeverities": [
            "P0",
            "P1"
          ],
          "acceptableLocations": [
            {
              "path": "src/types.ts",
              "side": "LEFT",
              "start": 1,
              "end": 1
            },
            {
              "path": "src/client.ts",
              "side": "RIGHT",
              "start": 1,
              "end": 1
            }
          ],
          "rationale": "RequestOptions is still imported and used after its export is removed, so the module cannot type-check.",
          "lenses": [
            "correctness-contracts"
          ],
          "blocking": true,
          "crossFile": true,
          "requiredConcepts": [
            [
              "RequestOptions"
            ],
            [
              "export",
              "import",
              "type"
            ]
          ],
          "assertionPatterns": [
            [
              "RequestOptions.{0,100}(remov|miss|drop|no longer export|not export)",
              "(remov|miss|drop|no longer export|not export).{0,100}RequestOptions"
            ],
            [
              "(cannot|will not|fails? to).{0,80}(compil|type-check|resolv)",
              "(compil|type-check|resol).{0,80}(fail|error|break)"
            ]
          ],
          "contradictionPatterns": [
            "RequestOptions\\s+(?:is\\s+)?(?:still\\s+)?exported",
            "(?:compiles?|type-checks?|resolves?)\\s+(?:successfully|correctly|fine)",
            "\\bnot\\s+(?:missing|removed|broken)\\b"
          ]
        }
      ]
    },
