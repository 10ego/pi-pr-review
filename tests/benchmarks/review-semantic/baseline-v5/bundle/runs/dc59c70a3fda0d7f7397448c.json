  "findings": [
    {
      "title": "[P1] Restore tenant scoping in the document lookup",
      "body": "Any authenticated user who supplies the ID of a document owned by another tenant now receives that document. Before this PR, `findFirst` filtered on both `id` and `tenantId: ctx.user.tenantId`; after it, `where: { id }` matches any tenant's row, while the remaining guard (`if (!ctx.user) throw new UnauthorizedError()`) only checks authentication, not object ownership. This is a broken object-level authorization / cross-tenant IDOR (data disclosure) introduced directly by the removed line — a source audit confirms no compensating tenant filter exists elsewhere (no schema constraint, client extension, or other scoping in the repo). This also contradicts the PR's stated intent of \"preserving existing contracts,\" and callers previously relying on tenant-scoped results would silently start seeing foreign-tenant documents. Requires multi-tenant data and a caller-supplied foreign ID, which is the normal operating condition for this endpoint.",
      "severity": "P1",
      "location": {
        "path": "src/documents.ts",
        "side": "LEFT",
        "start": 34,
        "end": 34
      }
    }
  ],
