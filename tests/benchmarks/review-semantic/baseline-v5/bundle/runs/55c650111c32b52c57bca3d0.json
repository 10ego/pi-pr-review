  "findings": [
    {
      "title": "[P2] Chunk large ID batches to respect backend IN-clause parameter limits",
      "body": "Triggered when `ids` contains more distinct values than the database backend's per-statement bind-parameter limit (e.g. SQL Server's 2,100 parameters, SQLite's ~999 default, PostgreSQL's 65,535). The old implementation issued one single-parameter query per id, so it never exceeded a per-statement limit; the new single `findMany` at `src/users.ts:23` expands the full deduplicated list into one statement's parameter list, so an oversized batch fails the entire request where the previous code (slowly) succeeded. For a helper accepting an unbounded `ids: string[]`, chunking the list (e.g. into batches of a few hundred) or capping batch size preserves the batching win without the new failure mode.",
      "severity": "P2",
      "location": {
        "path": "src/users.ts",
        "side": "RIGHT",
        "start": 23,
        "end": 23
      }
    }
  ],
