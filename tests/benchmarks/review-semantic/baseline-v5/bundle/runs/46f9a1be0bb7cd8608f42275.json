  "findings": [
    {
      "title": "[P1] Restore `id` in `loadUser`'s return to satisfy the `User` contract",
      "body": "Bites on every successful call — no special input required. `src/users.ts:8` declares `User = { id: string; name: string }` and `loadUser` is annotated `Promise<User>`, but the changed return at line 12 produces `{ userId: row.id, name: row.display_name }`. Under standard TypeScript this fails type-checking (property `id` missing / excess `userId`); if emitted without type-checking, every caller reading `user.id` silently receives `undefined`. The PR body claims existing contracts are preserved, which is the opposite of the effect. Fix by reverting to `id: row.id`, or — if the rename is intentional — updating `User` to declare `userId` in the same change (no other files in this repo reference `User` yet, so the type and this line must simply agree atomically).",
      "severity": "P1",
      "location": {
        "path": "src/users.ts",
        "side": "RIGHT",
        "start": 12,
        "end": 12
      }
    }
