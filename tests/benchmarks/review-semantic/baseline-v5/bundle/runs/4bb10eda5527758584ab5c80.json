  "findings": [
    {
      "title": "[P2] Ignore abort errors from superseded searches",
      "body": "Every call to `search()` aborts the previous request via `this.active?.abort()` (line 21) and issues a new one with a fresh signal. When the API honors `AbortSignal` (the standard contract implied by passing the signal), the superseded request's promise rejects with an `AbortError`, and the new catch block now calls `this.renderError(error)` for it. Expected cancellation therefore renders as a failure whenever a user triggers a second search before the first completes — flashing an error state that may also overwrite the newer search's UI depending on settlement order. Guard the catch, e.g. return early when `this.active.signal.aborted` or `error.name === 'AbortError'`.",
      "severity": "P2",
      "location": {
        "path": "src/search.ts",
        "side": "RIGHT",
        "start": 26,
        "end": 27
      }
    }
  ],
