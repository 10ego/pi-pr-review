  "findings": [
    {
      "title": "[P2] Restore linear-time membership check in removedIds",
      "body": "The new code evaluates `current.map(candidate => candidate.id).includes(item.id)` inside the `previous.filter(...)` callback (`src/reconcile.ts:41`), rebuilding and linearly scanning an `m`-element array for each of the `n` previous items — O(n×m) time and `n` temporary array allocations, versus the previous O(n+m) `Set`-based lookup this diff removed. Output is identical, but large reconciliations (e.g. disjoint 20k-element inputs) go from milliseconds to seconds of latency and heavy GC pressure. Restoring the precomputed `currentIds` set (or a `Set` built once before the filter) keeps the refactor's shape while preserving linear behavior.",
      "severity": "P2",
      "location": {
        "path": "src/reconcile.ts",
        "side": "RIGHT",
        "start": 41,
        "end": 41
      }
    }
